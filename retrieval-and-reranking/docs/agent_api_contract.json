{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechJam Conversational Shopping Agent Contract",
  "reset_request": {
    "type": "object",
    "required": ["session_id", "user_profile"],
    "properties": {
      "session_id": {"type": "string", "minLength": 1},
      "user_profile": {
        "type": "object",
        "required": ["purchase_frequency", "average_prior_rating", "rating_style", "preference_tags", "summary"],
        "properties": {
          "purchase_frequency": {"type": "string"},
          "average_prior_rating": {"type": ["number", "null"]},
          "rating_style": {"type": "string"},
          "preference_tags": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "turn_request": {
    "type": "object",
    "required": ["session_id", "user_message", "turn", "top_k"],
    "properties": {
      "session_id": {"type": "string", "minLength": 1},
      "user_message": {"type": "string"},
      "turn": {"type": "integer", "minimum": 1, "maximum": 10},
      "top_k": {"const": 10}
    },
    "additionalProperties": false
  },
  "turn_response": {
    "type": "object",
    "required": ["message", "ask_attribute", "recommendations"],
    "properties": {
      "message": {"type": "string"},
      "ask_attribute": {
        "type": ["string", "null"],
        "enum": ["category", "material", "color", "size", "style", "brand", "budget", "feature", "use_case", "other", null]
      },
      "recommendations": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["parent_asin"],
          "properties": {
            "parent_asin": {"type": "string", "minLength": 1},
            "score": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "usage": {
        "type": "object",
        "required": ["prompt_tokens", "completion_tokens"],
        "properties": {
          "prompt_tokens": {"type": "integer", "minimum": 0},
          "completion_tokens": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
